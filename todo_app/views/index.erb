<!DOCTYPE html>
<html lang='Ja'>
  <head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <title>ToDoリスト</title>
  </head>
  <body>
    <h1>Todo</h1>
    <h2>Todoリスト</h2>
    <% if @todos.empty? %>
      <tr>
        <td>タスクがありません。</td>
      </tr>
    <% else %>
      <table border="1" style="border-collapse: collapse">
        <tr>
          <th>id</th>
          <th>title</th>
          <th>description</th>
          <th>completed</th>
          <th>created_at</th>
          <th>updated_at</th>
        </tr>
        <% @todos.each_with_index do |todo, index| %>
          <tr>
            <td class="<%= "strikeout" if todo.completed %>"><%= index + 1 %></td>
            <td class="<%= "strikeout" if todo.completed %>"><%= todo.title %></td>
            <td class="<%= "strikeout" if todo.completed %>"><%= todo.description %></td>
            <td class="<%= "strikeout" if todo.completed %>">
              <% if todo.completed %> 
                <!-- <%= todo.completed %> --> 
                完了 
              <% else %>
                <!--<%= todo.completed %> -->
                未完了
              <% end %>
            </td>
            <td class="<%= "strikeout" if todo.completed %>"><%= todo.created_at %></td>
            <td class="<%= "strikeout" if todo.completed %>"><%= todo.updated_at %></td>
            <td>
              <!-- 完了と未完了を切り替え -->
              <form action="/todos/<%= todo.id %>/toggle" method="post">
                <% if todo.completed %>
                  <input type="submit" value="未完了に変更">
                <% else %>
                  <input type="submit" value="完了に変更">
                <% end %>
              </form>
            </td>
            <td>
              <form>
                <!-- 編集ボタンを押すと、各レコードのID専用のURLに飛ぶ -->
                <input type="button" onclick="location.href='/todos/<%= todo.id %>/edit'" value="編集">
              </form>
            </td>
            <td>
              <form action="/todos/<%= todo.id %>/delete" method="post">
                <input type="submit" value="削除" onclick="return confirm('本当に削除しますか？');">
              </form>
            </td>
          </tr>
        <% end %>
      <% end %>
    </table>   
    <!--エラーを表示するif文-->
    <!--@newrecord&.title→値がnil（なし）の場合にnilを返し、そうでない場合は値を表示-->

    <% if @error %>
      <p class="error-message">タイトルを入力してください。</p>
    <% end %>

    <div class= "post-forms">
      <h2>投稿用フォーム</h2>
      <form action="/todos" method="post">
        <input type="text" name="title" placeholder="タイトル" value = "<%= @newrecord&.title %>">
        <input type="text" name="description" placeholder="タスクの詳細" value = "<%= @newrecord&.description %>">
        <input type="submit" value="投稿">
      </form>
    </div>
    <div class= "filter">
      <a href="/?filter=all">全件表示</a><br>
      <a href="/?filter=active">未完了を表示</a><br>
      <a href="/?filter=completed">完了を表示</a><br>
    </div>
  </body>
</html>
