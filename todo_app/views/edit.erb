<!DOCTYPE html>
<html lang = 'Ja'>
  <head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <title>ToDo編集</title>
  </head>
  <body>
    <h1>ToDo編集ページ</h1>
    <table border="1" style="border-collapse: collapse">
      <tr>
        <th>id</th>
        <th>title</th>
        <th>description</th>
        <th>completed</th>
        <th>created_at</th>
        <th>updated_at</th>
      </tr>
      <tr>
        <td><%= @record.id %></td>
        <td><%= @record.title %></td>
        <td><%= @record.description %></td>
        <td>
          <% if @record.completed == 1 then %>
            完了
          <% else %>
            未完了
          <% end %>
        </td> 
        <td><%= @record.created_at %></td>
        <td><%= @record.updated_at %></td>
      </tr>
    </table>
    <div class= "post-forms">
      <h2>修正用フォーム</h2>
      <p>修正したいレコードのタイトル、タスクの説明を入力します。</p>
      <form action="/<%= @record.id %>" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="text" name="title" placeholder="タイトル">
        <input type="text" name="description" placeholder="タスクの詳細">
        <input type="submit" value="投稿">
      </form>
    </div>
    <a href="/" class="to-index-btn">Topページに戻る</a>
  </body>
</html>
